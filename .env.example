export SPOTIFY_CLIENT_ID=your_client_id_here
export SPOTIFY_CLIENT_SECRET=your_client_secret_here

# Optional. If set, the tool falls back to Claude when a MusicBrainz
# work search returns no results, asking for canonical alias terms
# (e.g. translates "Mass in B minor" -> "h-Moll-Messe" / "BWV 232").
# Without this set the tool just reports "No works found." as before.
export ANTHROPIC_API_KEY=your_anthropic_key_here

